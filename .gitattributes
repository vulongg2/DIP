# Auto detect text files and perform LF normalization
* text=auto

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Linux scripts
*.sh text eol=lf

# Binary model checkpoints stored directly (all < 25MB) so GitHub 'Download ZIP' works out-of-the-box
*.pt binary
*.pth binary
*.onnx binary
